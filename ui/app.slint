import { Button, LineEdit, ScrollView } from "std-widgets.slint";

export struct TreeEntry {
    name: string,
    icon: image,
    icon-label: string,
    depth: int,
    is-directory: bool,
    is-expanded: bool,
    git-mark: string,
    project-kind: string,
}

export struct TabEntry {
    id: int,
    title: string,
    detail: string,
    kind: string,
    group: int,
    active: bool,
    dirty: bool,
}

export struct TerminalCell {
    glyph: string,
    foreground: color,
    background: color,
    bold: bool,
    cursor: bool,
    column-span: int,
}

component WorkspaceGroup inherits Rectangle {
    in property <int> group-id: 0;
    in property <[TabEntry]> tabs;
    in property <bool> focused: false;
    in property <int> active-tab-id: -1;
    in property <string> active-kind: "";
    in property <string> active-title: "";
    in property <string> active-detail: "";
    in-out property <string> editor-text;
    in property <styled-text> highlighted-text;
    in property <bool> syntax-highlight-enabled: false;
    in property <int> editor-cursor-offset: 0;
    in-out property <int> editor-cursor-generation: 0;
    in property <string> line-numbers: "1";
    in property <bool> find-visible: false;
    in property <[TerminalCell]> terminal-cells;
    in property <int> terminal-grid-columns: 80;
    in property <int> terminal-grid-rows: 24;
    in property <int> terminal-cursor-row: -1;
    in property <int> terminal-cursor-column: -1;
    in-out property <int> terminal-update-generation: 0;
    out property <float> terminal-columns: terminal-focus.width / 8px;
    out property <float> terminal-rows: terminal-focus.height / 18px;
    out property <length> terminal-scroll-offset: terminal-scroll.viewport-y;
    out property <bool> terminal-ime-active: terminal-ime-input.has-focus;
    out property <string> terminal-ime-buffer: terminal-ime-input.text;
    out property <length> tab-scroll-offset: group-tabs-flickable.viewport-x;
    out property <length> editor-surface-width: file-layer.width;
    out property <length> editor-surface-height: file-layer.height;
    out property <length> terminal-surface-width: terminal-scroll.width;
    out property <length> terminal-surface-height: terminal-scroll.height;
    out property <length> terminal-canvas-width: terminal-canvas.width;
    out property <length> terminal-canvas-height: terminal-canvas.height;
    out property <int> editor-selection-length: self.editor-selection-cursor >= self.editor-selection-anchor
        ? self.editor-selection-cursor - self.editor-selection-anchor
        : self.editor-selection-anchor - self.editor-selection-cursor;
    out property <bool> copy-feedback-active: false;
    private property <int> editor-selection-anchor: 0;
    private property <int> editor-selection-cursor: 0;

    callback editor-edited(string, int);
    callback editor-selection-changed(int, int, int);
    callback undo-requested(int);
    callback redo-requested(int);
    callback save-requested(int);
    callback find-requested(int, string);
    callback find-visibility-requested(int, bool);
    callback terminal-key(int, string, bool, bool, bool);
    callback terminal-text(int, string);
    callback tab-activated(int);
    callback tab-close(int);
    callback new-terminal-requested(int);
    callback group-focused(int);
    callback toggle-maximize(int);
    callback tab-drag-moved(int, length, length);
    callback tab-drag-released(int);
    callback tab-drag-cancelled();

    public function focus-terminal() {
        terminal-ime-input.focus();
    }

    function reveal-tab(tab-x: length, tab-width: length) {
        if (tab-x + group-tabs-flickable.viewport-x < 0px) {
            group-tabs-flickable.viewport-x = -tab-x;
        } else if (tab-x + tab-width + group-tabs-flickable.viewport-x > group-tabs-flickable.width) {
            group-tabs-flickable.viewport-x = group-tabs-flickable.width - tab-x - tab-width;
        }
    }

    function scroll-tabs(delta-x: length, delta-y: length) {
        if (group-tabs-flickable.viewport-width <= group-tabs-flickable.width) {
            return;
        }
        group-tabs-flickable.viewport-x = max(
            group-tabs-flickable.width - group-tabs-flickable.viewport-width,
            min(0px, group-tabs-flickable.viewport-x + (delta-x != 0px ? delta-x : delta-y))
        );
    }

    function show-copy-feedback() {
        self.copy-feedback-active = true;
        copy-feedback-timer.restart();
    }

    copy-feedback-timer := Timer {
        interval: 1200ms;
        running: false;
        triggered => {
            root.copy-feedback-active = false;
            self.stop();
        }
    }

    background: #181a1f;
    clip: true;

    VerticalLayout {
        spacing: 0px;

        pane-tab-bar := Rectangle {
            height: 36px;
            background: #202329;
            border-width: 1px;
            border-color: root.focused ? #3d5268 : #2b2f36;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 2px;
                background: root.focused ? #5ca8e6 : transparent;
            }

            HorizontalLayout {
                y: 2px;
                height: parent.height - 2px;
                spacing: 1px;

                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    group-tabs-flickable := Flickable {
                        width: parent.width;
                        height: parent.height;
                        viewport-width: max(self.width, group-tabs-row.preferred-width);
                        viewport-height: self.height;
                        interactive: false;

                        group-tabs-row := HorizontalLayout {
                            width: group-tabs-flickable.viewport-width;
                            height: group-tabs-flickable.height;
                            spacing: 1px;

                            for tab in root.tabs: Rectangle {
                                private property <bool> active: tab.id == root.active-tab-id;
                                width: min(210px, max(108px, local-tab-title.preferred-width + 48px));
                                background: self.active ? #1e1e1e
                                    : (local-tab-touch.has-hover || local-tab-close-touch.has-hover ? #30343c : #25282f);
                                border-width: self.active ? 1px : 0px;
                                border-color: root.focused ? #3a4655 : #30343b;

                                changed active => {
                                    if (self.active) { root.reveal-tab(self.x, self.width); }
                                }
                                changed x => {
                                    if (self.active) { root.reveal-tab(self.x, self.width); }
                                }

                                local-tab-title := Text {
                                    x: 9px;
                                    width: parent.width - 43px;
                                    text: (tab.kind == "terminal" ? ">_ " : "") + tab.title
                                        + (tab.dirty ? " ●" : "");
                                    color: tab.kind == "terminal" ? #82c7ff
                                        : (parent.active ? #f1f1f1 : #aeb4bf);
                                    font-family: tab.kind == "terminal" ? "Cascadia Mono" : "Geist";
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                local-tab-touch := TouchArea {
                                    private property <length> press-x: 0px;
                                    private property <length> press-y: 0px;
                                    width: parent.width - 32px;
                                    mouse-cursor: move;
                                    moved => {
                                        if (!self.pressed || (abs(self.mouse-x - self.press-x) < 5px
                                            && abs(self.mouse-y - self.press-y) < 5px)) {
                                            return;
                                        }
                                        root.tab-drag-moved(
                                            tab.id,
                                            self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y
                                        );
                                    }
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down) {
                                            self.press-x = self.mouse-x;
                                            self.press-y = self.mouse-y;
                                            root.group-focused(root.group-id);
                                        } else if (event.kind == PointerEventKind.up) {
                                            root.tab-drag-released(tab.id);
                                        } else if (event.kind == PointerEventKind.cancel) {
                                            root.tab-drag-cancelled();
                                        }
                                    }
                                    clicked => { root.tab-activated(tab.id); }
                                    scroll-event(event) => {
                                        root.scroll-tabs(event.delta-x, event.delta-y);
                                        return accept;
                                    }
                                }

                                Rectangle {
                                    x: parent.width - 30px;
                                    y: 3px;
                                    width: 27px;
                                    height: 27px;
                                    border-radius: 4px;
                                    background: local-tab-close-touch.has-hover ? #454a54 : transparent;
                                    Text {
                                        text: "×";
                                        color: local-tab-close-touch.has-hover ? #ffffff : #abb0ba;
                                        font-family: "Segoe UI Symbol";
                                        font-size: 18px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    local-tab-close-touch := TouchArea {
                                        clicked => { root.tab-close(tab.id); }
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: #202329;
                                blank-tab-bar-touch := TouchArea {
                                    clicked => { root.group-focused(root.group-id); }
                                    scroll-event(event) => {
                                        root.scroll-tabs(event.delta-x, event.delta-y);
                                        return accept;
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    width: 38px;
                    background: group-new-terminal-touch.has-hover ? #343943 : transparent;
                    Text {
                        text: ">_+";
                        color: #82c7ff;
                        font-family: "Cascadia Mono";
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    group-new-terminal-touch := TouchArea {
                        clicked => {
                            root.group-focused(root.group-id);
                            root.new-terminal-requested(root.group-id);
                        }
                    }
                }

            }
        }

        content-stack := Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: #181a1f;
            clip: true;

        file-layer := Rectangle {
            visible: root.active-kind == "file";
            width: parent.width;
            height: parent.height;
            background: #1e1e1e;

            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: root.find-visible ? 36px : 0px;
                    background: #24272e;
                    clip: true;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        find-input := LineEdit {
                            placeholder-text: "Find in current file";
                            edited(text) => { root.find-requested(root.active-tab-id, text); }
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "Close";
                            clicked => { root.find-visibility-requested(root.group-id, false); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 0px;
                    Rectangle {
                        width: 48px;
                        background: #1e1e1e;
                        clip: true;
                        Text {
                            text: root.line-numbers;
                            color: #858585;
                            font-family: "Cascadia Mono";
                            font-size: 14px;
                            horizontal-alignment: right;
                            vertical-alignment: top;
                            x: 4px;
                            width: parent.width - 10px;
                            y: 6px + editor-scroll.viewport-y;
                        }
                    }
                    editor-pane := Rectangle {
                        private property <length> cursor-x: 0px;
                        private property <length> cursor-y: 0px;
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        background: #1e1e1e;
                        clip: true;

                        editor-scroll := ScrollView {
                            x: 10px;
                            y: 6px;
                            width: parent.width - 10px;
                            height: parent.height - 6px;
                            viewport-width: max(self.visible-width, code-input.preferred-width + 2px);
                            viewport-height: max(self.visible-height, code-input.preferred-height + 4px);

                            if root.syntax-highlight-enabled: StyledText {
                                width: editor-scroll.viewport-width;
                                height: editor-scroll.viewport-height;
                                text: root.highlighted-text;
                                default-color: #d4d4d4;
                                default-font-family: "Cascadia Mono";
                                default-font-size: 14px;
                                vertical-alignment: top;
                            }

                            code-input := TextInput {
                                private property <int> requested-cursor-generation: root.editor-cursor-generation;
                                width: editor-scroll.viewport-width;
                                height: editor-scroll.viewport-height;
                                text <=> root.editor-text;
                                single-line: false;
                                wrap: no-wrap;
                                font-family: "Cascadia Mono";
                                font-size: 14px;
                                color: root.syntax-highlight-enabled && self.preedit-text == "" ? transparent : #d4d4d4;
                                selection-background-color: #264f78;
                                selection-foreground-color: #ffffff;
                                page-height: editor-scroll.visible-height;
                                text-cursor-width: 0px;
                                changed requested-cursor-generation => {
                                    self.set-selection-offsets(root.editor-cursor-offset, root.editor-cursor-offset);
                                }
                                edited => {
                                    root.group-focused(root.group-id);
                                    root.editor-edited(self.text, root.active-tab-id);
                                }
                                key-pressed(event) => {
                                    root.group-focused(root.group-id);
                                    if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                                        self.copy(); return accept;
                                    }
                                    if (event.modifiers.control && (event.text == "x" || event.text == "X")) {
                                        self.cut(); return accept;
                                    }
                                    if (event.modifiers.control && (event.text == "a" || event.text == "A")) {
                                        self.select-all(); return accept;
                                    }
                                    if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                                        if (event.modifiers.shift) { root.redo-requested(root.active-tab-id); }
                                        else { root.undo-requested(root.active-tab-id); }
                                        return accept;
                                    }
                                    if (event.modifiers.control && (event.text == "y" || event.text == "Y")) {
                                        root.redo-requested(root.active-tab-id); return accept;
                                    }
                                    if (event.modifiers.control && (event.text == "s" || event.text == "S")) {
                                        root.save-requested(root.active-tab-id); return accept;
                                    }
                                    if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                                        root.find-visibility-requested(root.group-id, true); return accept;
                                    }
                                    return reject;
                                }
                                cursor-position-changed(position) => {
                                    root.group-focused(root.group-id);
                                    root.editor-selection-anchor = self.anchor-position-byte-offset;
                                    root.editor-selection-cursor = self.cursor-position-byte-offset;
                                    root.copy-feedback-active = false;
                                    copy-feedback-timer.stop();
                                    root.editor-selection-changed(
                                        root.active-tab-id,
                                        self.anchor-position-byte-offset,
                                        self.cursor-position-byte-offset
                                    );
                                    editor-pane.cursor-x = position.x;
                                    editor-pane.cursor-y = position.y;
                                    if (position.x + editor-scroll.viewport-x < 0px) {
                                        editor-scroll.viewport-x = max(editor-scroll.visible-width - self.width, -position.x);
                                    } else if (position.x + editor-scroll.viewport-x > editor-scroll.visible-width - 2px) {
                                        editor-scroll.viewport-x = min(0px, max(editor-scroll.visible-width - self.width, editor-scroll.visible-width - position.x - 2px));
                                    }
                                    if (position.y + editor-scroll.viewport-y < 0px) {
                                        editor-scroll.viewport-y = max(editor-scroll.visible-height - self.height, -position.y);
                                    } else if (position.y + editor-scroll.viewport-y > editor-scroll.visible-height - 20px) {
                                        editor-scroll.viewport-y = min(0px, max(editor-scroll.visible-height - self.height, editor-scroll.visible-height - position.y - 20px));
                                    }
                                }
                            }

                            Rectangle {
                                x: editor-pane.cursor-x;
                                y: editor-pane.cursor-y;
                                width: 2px;
                                height: 18px;
                                background: #f0f0f0;
                                visible: code-input.has-focus
                                    && code-input.preedit-text == ""
                                    && code-input.cursor-position-byte-offset == code-input.anchor-position-byte-offset;
                            }
                        }

                        if root.editor-selection-length > 0: Rectangle {
                            x: parent.width - 92px;
                            y: 8px;
                            width: 78px;
                            height: 28px;
                            border-radius: 4px;
                            background: root.copy-feedback-active ? #2e7d4f
                                : (copy-selection-touch.has-hover ? #3a3d43 : #292c32);
                            border-width: 1px;
                            border-color: root.copy-feedback-active ? #55b979 : #555960;
                            Text {
                                text: root.copy-feedback-active ? "Copied!" : "Copy";
                                color: #f0f0f0;
                                font-family: "Geist";
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            copy-selection-touch := TouchArea {
                                clicked => { code-input.copy(); root.show-copy-feedback(); }
                            }
                        }
                    }
                }
            }
        }

        terminal-focus := FocusScope {
            visible: root.active-kind == "terminal";
            width: parent.width;
            height: parent.height;
            focus-on-click: true;
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: #0f1115;
            }
            terminal-scroll := ScrollView {
                width: parent.width;
                height: parent.height;
                viewport-width: max(self.visible-width, root.terminal-grid-columns * 8px);
                viewport-height: max(self.visible-height, root.terminal-grid-rows * 18px);
                viewport-x: 0px;
                viewport-y: 0px;
                private property <int> follow-generation: root.terminal-update-generation;
                private property <length> cursor-top: max(0, root.terminal-cursor-row) * 18px;
                private property <length> cursor-bottom: self.cursor-top + 18px;
                changed follow-generation => {
                    if (root.terminal-cursor-row >= 0) {
                        if (self.cursor-top + self.viewport-y < 0px) {
                            self.viewport-y = -self.cursor-top;
                        } else if (self.cursor-bottom + self.viewport-y > self.visible-height) {
                            self.viewport-y = self.visible-height - self.cursor-bottom;
                        }
                        self.viewport-y = max(self.visible-height - self.viewport-height, min(0px, self.viewport-y));
                    }
                }
                terminal-canvas := Rectangle {
                    width: terminal-scroll.viewport-width;
                    height: terminal-scroll.viewport-height;
                    background: #111318;
                    for cell[index] in root.terminal-cells: Rectangle {
                        x: Math.mod(index, max(1, root.terminal-grid-columns)) * 8px;
                        y: floor(index / max(1, root.terminal-grid-columns)) * 18px;
                        width: cell.column-span * 8px;
                        height: 18px;
                        visible: cell.column-span > 0;
                        background: cell.cursor ? cell.foreground : cell.background;
                        Text {
                            text: cell.glyph;
                            color: cell.cursor ? cell.background : cell.foreground;
                            font-family: "Cascadia Mono";
                            font-size: 14px;
                            font-weight: cell.bold ? 700 : 500;
                            width: parent.width;
                            height: parent.height;
                            vertical-alignment: center;
                            wrap: no-wrap;
                        }
                    }
                }
            }
            terminal-ime-input := TextInput {
                x: max(0px, root.terminal-cursor-column * 8px + terminal-scroll.viewport-x);
                y: max(0px, root.terminal-cursor-row * 18px + terminal-scroll.viewport-y);
                width: max(18px, terminal-focus.width - self.x);
                height: 18px;
                text: "";
                single-line: true;
                wrap: no-wrap;
                font-family: "Cascadia Mono";
                font-size: 14px;
                font-weight: 500;
                color: #d8dee9;
                selection-background-color: #264f78;
                selection-foreground-color: #ffffff;
                text-cursor-width: 0px;
                edited => {
                    root.group-focused(root.group-id);
                    if (self.text != "") {
                        root.terminal-text(root.active-tab-id, self.text);
                        self.text = "";
                        self.set-selection-offsets(0, 0);
                    }
                }
                key-pressed(event) => {
                    root.group-focused(root.group-id);
                    if (event.text == Key.Shift || event.text == Key.ShiftR
                        || event.text == Key.Control || event.text == Key.ControlR
                        || event.text == Key.Alt || event.text == Key.AltGr
                        || event.text == Key.Meta || event.text == Key.MetaR
                        || event.text == Key.CapsLock) { return accept; }
                    if (event.text == Key.UpArrow) { root.terminal-key(root.active-tab-id, "<UP>", event.modifiers.control, event.modifiers.alt, event.modifiers.shift); return accept; }
                    if (event.text == Key.DownArrow) { root.terminal-key(root.active-tab-id, "<DOWN>", event.modifiers.control, event.modifiers.alt, event.modifiers.shift); return accept; }
                    if (event.text == Key.LeftArrow) { root.terminal-key(root.active-tab-id, "<LEFT>", event.modifiers.control, event.modifiers.alt, event.modifiers.shift); return accept; }
                    if (event.text == Key.RightArrow) { root.terminal-key(root.active-tab-id, "<RIGHT>", event.modifiers.control, event.modifiers.alt, event.modifiers.shift); return accept; }
                    if (event.text == Key.Home) { root.terminal-key(root.active-tab-id, "<HOME>", false, false, false); return accept; }
                    if (event.text == Key.End) { root.terminal-key(root.active-tab-id, "<END>", false, false, false); return accept; }
                    if (event.text == Key.PageUp) { root.terminal-key(root.active-tab-id, "<PAGEUP>", false, false, false); return accept; }
                    if (event.text == Key.PageDown) { root.terminal-key(root.active-tab-id, "<PAGEDOWN>", false, false, false); return accept; }
                    if (event.text == Key.Delete) { root.terminal-key(root.active-tab-id, "<DELETE>", false, false, false); return accept; }
                    if (event.text == Key.Backspace) { root.terminal-key(root.active-tab-id, "<BACKSPACE>", false, false, false); return accept; }
                    if (event.text == Key.Return) { root.terminal-key(root.active-tab-id, "<ENTER>", false, false, false); return accept; }
                    if (event.text == Key.Backtab) { root.terminal-key(root.active-tab-id, "<BACKTAB>", false, false, false); return accept; }
                    if (event.text == Key.Tab) { root.terminal-key(root.active-tab-id, "<TAB>", false, false, false); return accept; }
                    if (event.text == Key.Escape) { root.terminal-key(root.active-tab-id, "<ESCAPE>", false, false, false); return accept; }
                    if (event.modifiers.control || event.modifiers.alt) {
                        root.terminal-key(root.active-tab-id, event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
                        return accept;
                    }
                    return reject;
                }
            }
            terminal-click := TouchArea {
                clicked => { root.group-focused(root.group-id); root.focus-terminal(); }
            }
        }

        if root.active-kind == "": Rectangle {
            width: parent.width;
            height: parent.height;
            background: #181a1f;
            Text {
                text: "Drop a file or terminal tab here";
                color: #737985;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        }
    }
}

export component AppWindow inherits Window {
    title: "Araseo";
    icon: @image-url("../assets/araseo-app-icon.png");
    no-frame: true;
    resize-border-width: root.maximized ? 0px : 5px;
    default-font-family: "Geist";
    default-font-size: 12px;
    default-font-weight: 400;
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 800px;
    min-height: 600px;
    background: #181a1f;

    in property <string> workspace-name: "No workspace";
    in property <[TreeEntry]> tree-entries;
    in property <[TabEntry]> primary-tabs;
    in property <[TabEntry]> secondary-tabs;
    in-out property <string> editor-text;
    in property <styled-text> highlighted-text;
    in property <bool> syntax-highlight-enabled: false;
    in property <int> editor-cursor-offset: 0;
    in-out property <int> editor-cursor-generation: 0;
    in property <string> line-numbers: "1";
    in property <string> active-path: "";
    in property <string> status-text: "Ready";
    in property <bool> save-conflict: false;
    in property <[TerminalCell]> terminal-cells;
    in property <int> terminal-grid-columns: 80;
    in property <int> terminal-grid-rows: 24;
    in property <int> terminal-cursor-row: -1;
    in property <int> terminal-cursor-column: -1;
    in-out property <int> terminal-update-generation: 0;
    out property <float> terminal-columns: primary-view.terminal-columns;
    out property <float> terminal-rows: primary-view.terminal-rows;
    out property <length> terminal-scroll-offset: primary-view.terminal-scroll-offset;
    out property <bool> terminal-ime-active: primary-view.terminal-ime-active;
    out property <string> terminal-ime-buffer: primary-view.terminal-ime-buffer;
    in-out property <string> secondary-editor-text;
    in property <styled-text> secondary-highlighted-text;
    in property <bool> secondary-syntax-highlight-enabled: false;
    in property <int> secondary-editor-cursor-offset: 0;
    in-out property <int> secondary-editor-cursor-generation: 0;
    in property <string> secondary-line-numbers: "1";
    in property <[TerminalCell]> secondary-terminal-cells;
    in property <int> secondary-terminal-grid-columns: 80;
    in property <int> secondary-terminal-grid-rows: 24;
    in property <int> secondary-terminal-cursor-row: -1;
    in property <int> secondary-terminal-cursor-column: -1;
    in-out property <int> secondary-terminal-update-generation: 0;
    out property <float> secondary-terminal-columns: secondary-view.terminal-columns;
    out property <float> secondary-terminal-rows: secondary-view.terminal-rows;
    out property <length> secondary-terminal-scroll-offset: secondary-view.terminal-scroll-offset;
    out property <bool> secondary-terminal-ime-active: secondary-view.terminal-ime-active;
    out property <string> secondary-terminal-ime-buffer: secondary-view.terminal-ime-buffer;
    out property <length> primary-tab-scroll-offset: primary-view.tab-scroll-offset;
    out property <length> secondary-tab-scroll-offset: secondary-view.tab-scroll-offset;
    out property <length> primary-editor-surface-width: primary-view.editor-surface-width;
    out property <length> primary-editor-surface-height: primary-view.editor-surface-height;
    out property <length> primary-terminal-surface-width: primary-view.terminal-surface-width;
    out property <length> primary-terminal-surface-height: primary-view.terminal-surface-height;
    out property <length> primary-terminal-canvas-width: primary-view.terminal-canvas-width;
    out property <length> primary-terminal-canvas-height: primary-view.terminal-canvas-height;
    in property <int> primary-active-tab-id: -1;
    in property <string> primary-active-kind: "";
    in property <string> primary-active-title: "";
    in property <string> primary-active-detail: "";
    in property <int> secondary-active-tab-id: -1;
    in property <string> secondary-active-kind: "";
    in property <string> secondary-active-title: "";
    in property <string> secondary-active-detail: "";
    in-out property <int> focused-group: 0;
    in-out property <bool> find-visible: false;
    out property <int> editor-selection-length: root.focused-group == 1
        ? (root.secondary-active-kind == "file" ? secondary-view.editor-selection-length : 0)
        : (root.primary-active-kind == "file" ? primary-view.editor-selection-length : 0);
    out property <bool> copy-feedback-active: root.focused-group == 1
        ? (root.secondary-active-kind == "file" && secondary-view.copy-feedback-active)
        : (root.primary-active-kind == "file" && primary-view.copy-feedback-active);
    in-out property <int> workspace-layout: 0;
    in-out property <float> panel-split-ratio: 0.64;
    out property <length> primary-group-x: primary-view.x;
    out property <length> primary-group-y: primary-view.y;
    out property <length> primary-group-width: primary-view.width;
    out property <length> primary-group-height: primary-view.height;
    out property <bool> primary-group-visible: primary-view.visible;
    out property <length> secondary-group-x: secondary-view.x;
    out property <length> secondary-group-y: secondary-view.y;
    out property <length> secondary-group-width: secondary-view.width;
    out property <length> secondary-group-height: secondary-view.height;
    out property <bool> secondary-group-visible: secondary-view.visible;
    private property <length> sidebar-width: 250px;
    private property <int> dragging-tab: -1;
    private property <int> dock-preview: -1;
    private property <int> restore-layout: 0;
    private property <bool> has-secondary-group: root.secondary-tabs.length > 0;

    callback tree-activated(int);
    callback tab-activated(int);
    callback tab-cycle(int);
    callback tab-close(int);
    callback editor-edited(string, int);
    callback editor-selection-changed(int, int);
    callback undo-requested(int);
    callback redo-requested(int);
    callback save-requested(int);
    callback force-save-requested();
    callback reload-requested();
    callback find-requested(int, string);
    callback terminal-key(int, string, bool, bool, bool);
    callback terminal-text(int, string);
    callback terminal-paste(string);
    callback new-terminal-requested(int);
    callback tab-dock-requested(int, int);
    callback focused-group-changed(int);
    callback window-drag-requested();

    public function focus-terminal() {
        if (root.focused-group == 1) {
            secondary-view.focus-terminal();
        } else {
            primary-view.focus-terminal();
        }
    }

    public function toggle-panel-maximize(panel: int) {
        let maximized-layout = panel == 1 ? 5 : 4;
        if (root.workspace-layout == maximized-layout) {
            root.workspace-layout = root.restore-layout;
        } else {
            if (root.workspace-layout <= 3) {
                root.restore-layout = root.workspace-layout;
            }
            root.workspace-layout = maximized-layout;
        }
    }

    function update-dock-preview(tab-id: int, x: length, y: length) {
        root.dragging-tab = tab-id;
        let local-x = x - workspace-area.absolute-position.x;
        let local-y = y - workspace-area.absolute-position.y;
        if (local-x < workspace-area.width * 0.25) {
            root.dock-preview = 0;
        } else if (local-x > workspace-area.width * 0.75) {
            root.dock-preview = 1;
        } else if (local-y < workspace-area.height * 0.25) {
            root.dock-preview = 2;
        } else if (local-y > workspace-area.height * 0.75) {
            root.dock-preview = 3;
        } else if (root.has-secondary-group
            && local-x >= secondary-view.x && local-x <= secondary-view.x + secondary-view.width
            && local-y >= secondary-view.y && local-y <= secondary-view.y + secondary-view.height) {
            root.dock-preview = 5;
        } else {
            root.dock-preview = 4;
        }
    }

    function finish-tab-drag(tab-id: int) {
        if (root.dragging-tab != tab-id || root.dock-preview < 0) {
            return;
        }
        let zone = root.dock-preview;
        if (zone == 0) { root.workspace-layout = 2; }
        else if (zone == 1) { root.workspace-layout = 3; }
        else if (zone == 2) { root.workspace-layout = 1; }
        else if (zone == 3) { root.workspace-layout = 0; }
        root.tab-dock-requested(tab-id, zone);
        root.dragging-tab = -1;
        root.dock-preview = -1;
    }

    function cancel-tab-drag() {
        root.dragging-tab = -1;
        root.dock-preview = -1;
    }

    shortcut-scope := FocusScope {
        width: root.width;
        height: root.height;

        KeyBinding {
            keys: @keys(Control + Tab);
            activated => { root.tab-cycle(1); }
        }
        KeyBinding {
            keys: @keys(Control + Shift + Tab);
            activated => { root.tab-cycle(-1); }
        }

        VerticalLayout {
            spacing: 0px;

        Rectangle {
            height: 34px;
            background: #181a1f;
            HorizontalLayout {
                spacing: 1px;

                Rectangle {
                    width: root.sidebar-width;
                    background: title-left-touch.has-hover ? #24272e : #181a1f;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: center;
                        Image {
                            source: @image-url("../assets/araseo-app-icon.png");
                            width: 23px;
                            height: 23px;
                            image-fit: contain;
                        }
                        Text {
                            text: "Araseo";
                            color: #e6e8ec;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    title-left-touch := TouchArea {
                        moved => { root.window-drag-requested(); }
                        double-clicked => { root.maximized = !root.maximized; }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: title-drag-touch.has-hover ? #1d2026 : #181a1f;
                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        text: root.active-path;
                        color: #777e89;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    title-drag-touch := TouchArea {
                        moved => { root.window-drag-requested(); }
                        double-clicked => { root.maximized = !root.maximized; }
                    }
                }

                Rectangle {
                    width: 46px;
                    background: minimize-touch.has-hover ? #30333a : transparent;
                    Text { text: "—"; color: #d7dae0; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    minimize-touch := TouchArea { clicked => { root.minimized = true; } }
                }
                Rectangle {
                    width: 46px;
                    background: maximize-touch.has-hover ? #30333a : transparent;
                    Text {
                        text: root.maximized ? "❐" : "□";
                        color: #d7dae0;
                        font-family: "Segoe UI Symbol";
                        font-size: 19px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    maximize-touch := TouchArea { clicked => { root.maximized = !root.maximized; } }
                }
                Rectangle {
                    width: 46px;
                    background: close-touch.has-hover ? #c42b1c : transparent;
                    Text {
                        text: "×";
                        color: #d7dae0;
                        font-family: "Segoe UI Symbol";
                        font-size: 22px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    close-touch := TouchArea { clicked => { root.close(); } }
                }
            }
        }

        HorizontalLayout {
            spacing: 1px;
            Rectangle {
                horizontal-stretch: 0;
                width: root.sidebar-width;
                background: #20232a;
                VerticalLayout {
                    spacing: 0px;
                    Rectangle {
                        height: 30px;
                        background: #292d35;
                        Text {
                            text: "FILES";
                            color: #bbc0ca;
                            font-size: 11px;
                            vertical-alignment: center;
                            x: 10px;
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 0px;
                            for entry[index] in root.tree-entries: Rectangle {
                                height: 25px;
                                background: tree-touch.has-hover ? #343943 : transparent;
                                HorizontalLayout {
                                    padding-left: entry.depth * 14px + 8px;
                                    padding-right: 6px;
                                    spacing: 5px;
                                    Image {
                                        source: entry.icon;
                                        width: 22px;
                                        height: 22px;
                                        image-fit: contain;
                                    }
                                    Text {
                                        text: entry.name;
                                        color: entry.git-mark == "U" ? #65c466 : (entry.git-mark == "M" ? #e2b86b : #d5d8de);
                                        font-family: "Geist";
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: entry.git-mark;
                                        color: entry.git-mark == "U" ? #65c466 : #e2b86b;
                                        font-family: "Geist";
                                        font-size: 12px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                }
                                tree-touch := TouchArea { clicked => { root.tree-activated(index); } }
                            }
                        }
                    }

                }
            }

            workspace-area := Rectangle {
                background: #181a1f;
                horizontal-stretch: 1;
                max-width: 100000px;
                clip: true;
                private property <length> divider-size: 6px;
                private property <bool> vertical-split: root.has-secondary-group
                    && (root.workspace-layout == 0 || root.workspace-layout == 1);
                private property <bool> horizontal-split: root.has-secondary-group
                    && (root.workspace-layout == 2 || root.workspace-layout == 3);
                private property <length> primary-split-width: (self.width - self.divider-size) * root.panel-split-ratio;
                private property <length> secondary-split-width: self.width - self.divider-size - self.primary-split-width;
                private property <length> primary-split-height: (self.height - self.divider-size) * root.panel-split-ratio;
                private property <length> secondary-split-height: self.height - self.divider-size - self.primary-split-height;

                primary-view := WorkspaceGroup {
                    group-id: 0;
                    tabs: root.primary-tabs;
                    focused: root.focused-group == 0;
                    active-tab-id: root.primary-active-tab-id;
                    active-kind: root.primary-active-kind;
                    active-title: root.primary-active-title;
                    active-detail: root.primary-active-detail;
                    editor-text <=> root.editor-text;
                    highlighted-text: root.highlighted-text;
                    syntax-highlight-enabled: root.syntax-highlight-enabled;
                    editor-cursor-offset: root.editor-cursor-offset;
                    editor-cursor-generation <=> root.editor-cursor-generation;
                    line-numbers: root.line-numbers;
                    find-visible: root.find-visible && root.focused-group == 0;
                    terminal-cells: root.terminal-cells;
                    terminal-grid-columns: root.terminal-grid-columns;
                    terminal-grid-rows: root.terminal-grid-rows;
                    terminal-cursor-row: root.terminal-cursor-row;
                    terminal-cursor-column: root.terminal-cursor-column;
                    terminal-update-generation <=> root.terminal-update-generation;
                    x: root.workspace-layout == 2 && root.has-secondary-group
                        ? workspace-area.secondary-split-width + workspace-area.divider-size : 0px;
                    y: root.workspace-layout == 1 && root.has-secondary-group
                        ? workspace-area.secondary-split-height + workspace-area.divider-size : 0px;
                    width: workspace-area.horizontal-split ? workspace-area.primary-split-width : workspace-area.width;
                    height: workspace-area.vertical-split ? workspace-area.primary-split-height : workspace-area.height;
                    visible: !root.has-secondary-group || root.workspace-layout != 5;

                    editor-edited(text, tab-id) => { root.editor-edited(text, tab-id); }
                    editor-selection-changed(tab-id, anchor, cursor) => {
                        if (root.focused-group == 0) { root.editor-selection-changed(anchor, cursor); }
                    }
                    undo-requested(tab-id) => { root.undo-requested(tab-id); }
                    redo-requested(tab-id) => { root.redo-requested(tab-id); }
                    save-requested(tab-id) => { root.save-requested(tab-id); }
                    find-requested(tab-id, query) => { root.find-requested(tab-id, query); }
                    find-visibility-requested(group, visible) => {
                        root.focused-group = group;
                        root.find-visible = visible;
                        root.focused-group-changed(group);
                    }
                    terminal-key(tab-id, text, control, alt, shift) => {
                        root.terminal-key(tab-id, text, control, alt, shift);
                    }
                    terminal-text(tab-id, text) => { root.terminal-text(tab-id, text); }
                    tab-activated(tab-id) => { root.tab-activated(tab-id); }
                    tab-close(tab-id) => { root.tab-close(tab-id); }
                    new-terminal-requested(group) => { root.new-terminal-requested(group); }
                    group-focused(group) => {
                        root.focused-group = group;
                        root.focused-group-changed(group);
                    }
                    toggle-maximize(group) => { root.toggle-panel-maximize(group); }
                    tab-drag-moved(tab-id, x, y) => { root.update-dock-preview(tab-id, x, y); }
                    tab-drag-released(tab-id) => { root.finish-tab-drag(tab-id); }
                    tab-drag-cancelled => { root.cancel-tab-drag(); }
                }

                secondary-view := WorkspaceGroup {
                    group-id: 1;
                    tabs: root.secondary-tabs;
                    focused: root.focused-group == 1;
                    active-tab-id: root.secondary-active-tab-id;
                    active-kind: root.secondary-active-kind;
                    active-title: root.secondary-active-title;
                    active-detail: root.secondary-active-detail;
                    editor-text <=> root.secondary-editor-text;
                    highlighted-text: root.secondary-highlighted-text;
                    syntax-highlight-enabled: root.secondary-syntax-highlight-enabled;
                    editor-cursor-offset: root.secondary-editor-cursor-offset;
                    editor-cursor-generation <=> root.secondary-editor-cursor-generation;
                    line-numbers: root.secondary-line-numbers;
                    find-visible: root.find-visible && root.focused-group == 1;
                    terminal-cells: root.secondary-terminal-cells;
                    terminal-grid-columns: root.secondary-terminal-grid-columns;
                    terminal-grid-rows: root.secondary-terminal-grid-rows;
                    terminal-cursor-row: root.secondary-terminal-cursor-row;
                    terminal-cursor-column: root.secondary-terminal-cursor-column;
                    terminal-update-generation <=> root.secondary-terminal-update-generation;
                    x: root.workspace-layout == 3
                        ? workspace-area.primary-split-width + workspace-area.divider-size : 0px;
                    y: root.workspace-layout == 0
                        ? workspace-area.primary-split-height + workspace-area.divider-size : 0px;
                    width: workspace-area.horizontal-split ? workspace-area.secondary-split-width : workspace-area.width;
                    height: workspace-area.vertical-split ? workspace-area.secondary-split-height : workspace-area.height;
                    visible: root.has-secondary-group && root.workspace-layout != 4;

                    editor-edited(text, tab-id) => { root.editor-edited(text, tab-id); }
                    editor-selection-changed(tab-id, anchor, cursor) => {
                        if (root.focused-group == 1) { root.editor-selection-changed(anchor, cursor); }
                    }
                    undo-requested(tab-id) => { root.undo-requested(tab-id); }
                    redo-requested(tab-id) => { root.redo-requested(tab-id); }
                    save-requested(tab-id) => { root.save-requested(tab-id); }
                    find-requested(tab-id, query) => { root.find-requested(tab-id, query); }
                    find-visibility-requested(group, visible) => {
                        root.focused-group = group;
                        root.find-visible = visible;
                        root.focused-group-changed(group);
                    }
                    terminal-key(tab-id, text, control, alt, shift) => {
                        root.terminal-key(tab-id, text, control, alt, shift);
                    }
                    terminal-text(tab-id, text) => { root.terminal-text(tab-id, text); }
                    tab-activated(tab-id) => { root.tab-activated(tab-id); }
                    tab-close(tab-id) => { root.tab-close(tab-id); }
                    new-terminal-requested(group) => { root.new-terminal-requested(group); }
                    group-focused(group) => {
                        root.focused-group = group;
                        root.focused-group-changed(group);
                    }
                    toggle-maximize(group) => { root.toggle-panel-maximize(group); }
                    tab-drag-moved(tab-id, x, y) => { root.update-dock-preview(tab-id, x, y); }
                    tab-drag-released(tab-id) => { root.finish-tab-drag(tab-id); }
                    tab-drag-cancelled => { root.cancel-tab-drag(); }
                }

                panel-divider := Rectangle {
                    visible: workspace-area.vertical-split || workspace-area.horizontal-split;
                    x: workspace-area.horizontal-split
                        ? (root.workspace-layout == 2
                            ? workspace-area.secondary-split-width
                            : workspace-area.primary-split-width)
                        : 0px;
                    y: workspace-area.vertical-split
                        ? (root.workspace-layout == 1
                            ? workspace-area.secondary-split-height
                            : workspace-area.primary-split-height)
                        : 0px;
                    width: workspace-area.horizontal-split ? workspace-area.divider-size : workspace-area.width;
                    height: workspace-area.vertical-split ? workspace-area.divider-size : workspace-area.height;
                    background: divider-touch.pressed || divider-touch.has-hover ? #5686b3 : #313640;

                    divider-touch := TouchArea {
                        mouse-cursor: workspace-area.horizontal-split ? ew-resize : ns-resize;
                        moved => {
                            if (!self.pressed) { return; }
                            if (workspace-area.horizontal-split) {
                                let pointer-x = self.absolute-position.x + self.mouse-x
                                    - workspace-area.absolute-position.x;
                                root.panel-split-ratio = max(0.2, min(0.8,
                                    root.workspace-layout == 2
                                        ? (workspace-area.width - workspace-area.divider-size - pointer-x)
                                            / (workspace-area.width - workspace-area.divider-size)
                                        : pointer-x / (workspace-area.width - workspace-area.divider-size)
                                ));
                            } else {
                                let pointer-y = self.absolute-position.y + self.mouse-y
                                    - workspace-area.absolute-position.y;
                                root.panel-split-ratio = max(0.2, min(0.8,
                                    root.workspace-layout == 1
                                        ? (workspace-area.height - workspace-area.divider-size - pointer-y)
                                            / (workspace-area.height - workspace-area.divider-size)
                                        : pointer-y / (workspace-area.height - workspace-area.divider-size)
                                ));
                            }
                        }
                    }
                }

                if root.dragging-tab >= 0 && root.dock-preview >= 0: Rectangle {
                    x: root.dock-preview == 1 ? workspace-area.width / 2
                        : (root.dock-preview == 4 ? primary-view.x
                        : (root.dock-preview == 5 ? secondary-view.x : 0px));
                    y: root.dock-preview == 3 ? workspace-area.height / 2
                        : (root.dock-preview == 4 ? primary-view.y
                        : (root.dock-preview == 5 ? secondary-view.y : 0px));
                    width: root.dock-preview == 0 || root.dock-preview == 1
                        ? workspace-area.width / 2
                        : (root.dock-preview == 4 ? primary-view.width
                        : (root.dock-preview == 5 ? secondary-view.width : workspace-area.width));
                    height: root.dock-preview == 2 || root.dock-preview == 3
                        ? workspace-area.height / 2
                        : (root.dock-preview == 4 ? primary-view.height
                        : (root.dock-preview == 5 ? secondary-view.height : workspace-area.height));
                    background: #315f8a99;
                    border-width: 2px;
                    border-color: #79b8f3;
                    border-radius: 5px;

                    Text {
                        text: root.dock-preview == 0 ? "Move tab to left group"
                            : (root.dock-preview == 1 ? "Move tab to right group"
                            : (root.dock-preview == 2 ? "Move tab to top group"
                            : (root.dock-preview == 3 ? "Move tab to bottom group"
                            : (root.dock-preview == 5 ? "Move tab to this group"
                            : "Move tab to this group"))));
                        color: white;
                        font-family: "Geist";
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

        }

        Rectangle {
            height: 24px;
            background: #2f6f9f;
            HorizontalLayout {
                padding-left: 9px;
                padding-right: 9px;
                spacing: 6px;
                Text { text: root.workspace-name; color: white; vertical-alignment: center; }
                Text { text: root.active-path; color: white; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                if root.editor-selection-length > 0: Text {
                    text: root.editor-selection-length + " bytes selected";
                    color: white;
                    vertical-alignment: center;
                }
                Text { text: root.status-text; color: white; vertical-alignment: center; }
                if root.save-conflict: Button { text: "Reload"; clicked => { root.reload-requested(); } }
                if root.save-conflict: Button { text: "Overwrite"; clicked => { root.force-save-requested(); } }
            }
        }
    }

    }
}

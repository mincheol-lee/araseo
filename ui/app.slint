import { Button, LineEdit, ScrollView } from "std-widgets.slint";

export struct TreeEntry {
    name: string,
    icon: image,
    icon-label: string,
    depth: int,
    is-directory: bool,
    is-expanded: bool,
    git-mark: string,
    project-kind: string,
}

export struct TabEntry {
    title: string,
    dirty: bool,
}

export struct TerminalCell {
    glyph: string,
    foreground: color,
    background: color,
    bold: bool,
    cursor: bool,
    column-span: int,
}

export component AppWindow inherits Window {
    title: "Araseo";
    icon: @image-url("../assets/araseo-app-icon.png");
    no-frame: true;
    resize-border-width: root.maximized ? 0px : 5px;
    default-font-family: "Geist";
    default-font-size: 12px;
    default-font-weight: 400;
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 800px;
    min-height: 600px;
    background: #181a1f;

    in property <string> workspace-name: "No workspace";
    in property <[TreeEntry]> tree-entries;
    in property <[TabEntry]> tabs;
    in-out property <string> editor-text;
    in property <styled-text> highlighted-text;
    in property <bool> syntax-highlight-enabled: false;
    in property <int> editor-cursor-offset: 0;
    in-out property <int> editor-cursor-generation: 0;
    in property <string> line-numbers: "1";
    in property <string> active-path: "";
    in property <string> status-text: "Ready";
    in property <bool> save-conflict: false;
    in property <[TerminalCell]> terminal-cells;
    in property <int> terminal-grid-columns: 80;
    in property <int> terminal-grid-rows: 24;
    in property <int> terminal-cursor-row: -1;
    in property <int> terminal-cursor-column: -1;
    in-out property <int> terminal-update-generation: 0;
    out property <float> terminal-columns: terminal-focus.width / 8px;
    out property <float> terminal-rows: terminal-focus.height / 18px;
    out property <length> terminal-scroll-offset: terminal-scroll.viewport-y;
    out property <bool> terminal-ime-active: terminal-ime-input.has-focus;
    out property <string> terminal-ime-buffer: terminal-ime-input.text;
    out property <length> tab-scroll-offset: tabs-flickable.viewport-x;
    in property <int> active-tab: -1;
    in-out property <bool> tab-list-visible: false;
    in-out property <bool> find-visible: false;
    out property <int> editor-selection-length: root.editor-selection-cursor >= root.editor-selection-anchor
        ? root.editor-selection-cursor - root.editor-selection-anchor
        : root.editor-selection-anchor - root.editor-selection-cursor;
    out property <bool> copy-feedback-active: false;
    in-out property <int> workspace-layout: 0;
    in-out property <float> panel-split-ratio: 0.64;
    out property <length> editor-panel-x: editor-panel.x;
    out property <length> editor-panel-y: editor-panel.y;
    out property <length> editor-panel-width: editor-panel.width;
    out property <length> editor-panel-height: editor-panel.height;
    out property <bool> editor-panel-visible: editor-panel.visible;
    out property <length> terminal-panel-x: terminal-panel.x;
    out property <length> terminal-panel-y: terminal-panel.y;
    out property <length> terminal-panel-width: terminal-panel.width;
    out property <length> terminal-panel-height: terminal-panel.height;
    out property <bool> terminal-panel-visible: terminal-panel.visible;
    private property <int> editor-selection-anchor: 0;
    private property <int> editor-selection-cursor: 0;
    private property <length> sidebar-width: 250px;
    private property <int> dragging-panel: -1;
    private property <int> dock-preview: -1;
    private property <int> restore-layout: 0;

    callback tree-activated(int);
    callback tab-activated(int);
    callback tab-cycle(int);
    callback tab-close(int);
    callback editor-edited(string, int);
    callback editor-selection-changed(int, int);
    callback undo-requested(int);
    callback redo-requested(int);
    callback save-requested();
    callback force-save-requested();
    callback reload-requested();
    callback find-requested(string);
    callback terminal-key(string, bool, bool, bool);
    callback terminal-text(string);
    callback terminal-paste(string);
    callback window-drag-requested();

    function show-copy-feedback() {
        root.copy-feedback-active = true;
        copy-feedback-timer.restart();
    }

    function reveal-tab(tab-x: length, tab-width: length) {
        if (tab-x + tabs-flickable.viewport-x < 0px) {
            tabs-flickable.viewport-x = -tab-x;
        } else if (tab-x + tab-width + tabs-flickable.viewport-x > tabs-flickable.width) {
            tabs-flickable.viewport-x = tabs-flickable.width - tab-x - tab-width;
        }
    }

    function scroll-tabs(delta-x: length, delta-y: length) {
        if (tabs-flickable.viewport-width <= tabs-flickable.width) {
            return;
        }
        tabs-flickable.viewport-x = max(
            tabs-flickable.width - tabs-flickable.viewport-width,
            min(0px, tabs-flickable.viewport-x + (delta-x != 0px ? delta-x : delta-y))
        );
    }

    public function focus-terminal() {
        terminal-ime-input.focus();
    }

    public function dock-panel(panel: int, zone: int) {
        if (zone == 0) {
            root.workspace-layout = panel == 1 ? 2 : 3;
        } else if (zone == 1) {
            root.workspace-layout = panel == 1 ? 3 : 2;
        } else if (zone == 2) {
            root.workspace-layout = panel == 1 ? 1 : 0;
        } else if (zone == 3) {
            root.workspace-layout = panel == 1 ? 0 : 1;
        } else if (zone == 4) {
            if (root.workspace-layout <= 3) {
                root.restore-layout = root.workspace-layout;
            }
            root.workspace-layout = panel == 1 ? 5 : 4;
        }
        root.dragging-panel = -1;
        root.dock-preview = -1;
    }

    public function toggle-panel-maximize(panel: int) {
        let maximized-layout = panel == 1 ? 5 : 4;
        if (root.workspace-layout == maximized-layout) {
            root.workspace-layout = root.restore-layout;
        } else {
            if (root.workspace-layout <= 3) {
                root.restore-layout = root.workspace-layout;
            }
            root.workspace-layout = maximized-layout;
        }
    }

    function update-dock-preview(panel: int, x: length, y: length) {
        root.dragging-panel = panel;
        if (x < workspace-area.width * 0.25) {
            root.dock-preview = 0;
        } else if (x > workspace-area.width * 0.75) {
            root.dock-preview = 1;
        } else if (y < workspace-area.height * 0.25) {
            root.dock-preview = 2;
        } else if (y > workspace-area.height * 0.75) {
            root.dock-preview = 3;
        } else {
            root.dock-preview = 4;
        }
    }

    copy-feedback-timer := Timer {
        interval: 1200ms;
        running: false;
        triggered => {
            root.copy-feedback-active = false;
            self.stop();
        }
    }

    shortcut-scope := FocusScope {
        width: root.width;
        height: root.height;

        KeyBinding {
            keys: @keys(Control + Tab);
            activated => { root.tab-cycle(1); }
        }
        KeyBinding {
            keys: @keys(Control + Shift + Tab);
            activated => { root.tab-cycle(-1); }
        }

        VerticalLayout {
            spacing: 0px;

        Rectangle {
            height: 34px;
            background: #181a1f;
            HorizontalLayout {
                spacing: 1px;

                Rectangle {
                    width: root.sidebar-width;
                    background: title-left-touch.has-hover ? #24272e : #181a1f;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: center;
                        Image {
                            source: @image-url("../assets/araseo-app-icon.png");
                            width: 23px;
                            height: 23px;
                            image-fit: contain;
                        }
                        Text {
                            text: "Araseo";
                            color: #e6e8ec;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    title-left-touch := TouchArea {
                        moved => { root.window-drag-requested(); }
                        double-clicked => { root.maximized = !root.maximized; }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    tabs-flickable := Flickable {
                        width: parent.width;
                        height: parent.height;
                        viewport-width: max(self.width, tabs-row.preferred-width);
                        viewport-height: self.height;
                        interactive: false;

                        tabs-row := HorizontalLayout {
                            width: tabs-flickable.viewport-width;
                            height: tabs-flickable.height;
                            spacing: 1px;

                            for tab[index] in root.tabs: Rectangle {
                                private property <bool> active: index == root.active-tab;
                                width: min(190px, max(96px, tab-title.preferred-width + 52px));
                                background: self.active ? #20232a
                                    : (tab-touch.has-hover || tab-close-touch.has-hover ? #292d35 : #181a1f);
                                changed active => {
                                    if (self.active) {
                                        root.reveal-tab(self.x, self.width);
                                    }
                                }
                                changed x => {
                                    if (self.active) {
                                        root.reveal-tab(self.x, self.width);
                                    }
                                }
                                changed width => {
                                    if (self.active) {
                                        root.reveal-tab(self.x, self.width);
                                    }
                                }
                                tab-title := Text {
                                    x: 10px;
                                    width: parent.width - 48px;
                                    text: tab.title + (tab.dirty ? " ●" : "");
                                    color: parent.active ? #f1f1f1 : #aeb4bf;
                                    font-family: "Geist";
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                tab-touch := TouchArea {
                                    width: parent.width - 34px;
                                    clicked => { root.tab-activated(index); }
                                    scroll-event(event) => {
                                        root.scroll-tabs(event.delta-x, event.delta-y);
                                        return accept;
                                    }
                                }
                                Rectangle {
                                    x: parent.width - 31px;
                                    y: 3px;
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 4px;
                                    background: tab-close-touch.has-hover ? #3b4048 : transparent;
                                    Text {
                                        text: "×";
                                        color: tab-close-touch.has-hover ? #ffffff : #abb0ba;
                                        font-family: "Segoe UI Symbol";
                                        font-size: 19px;
                                        font-weight: 500;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    tab-close-touch := TouchArea {
                                        clicked => { root.tab-close(index); }
                                        scroll-event(event) => {
                                            root.scroll-tabs(event.delta-x, event.delta-y);
                                            return accept;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: title-drag-touch.has-hover ? #1d2026 : #181a1f;
                                title-drag-touch := TouchArea {
                                    moved => { root.window-drag-requested(); }
                                    double-clicked => { root.maximized = !root.maximized; }
                                    scroll-event(event) => {
                                        root.scroll-tabs(event.delta-x, event.delta-y);
                                        return accept;
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    width: 31px;
                    background: previous-tab-touch.has-hover ? #30333a : transparent;
                    Text {
                        text: "‹";
                        color: root.tabs.length > 1 ? #d7dae0 : #626872;
                        font-family: "Segoe UI Symbol";
                        font-size: 22px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    previous-tab-touch := TouchArea {
                        enabled: root.tabs.length > 1;
                        clicked => { root.tab-cycle(-1); }
                    }
                }
                Rectangle {
                    width: 31px;
                    background: next-tab-touch.has-hover ? #30333a : transparent;
                    Text {
                        text: "›";
                        color: root.tabs.length > 1 ? #d7dae0 : #626872;
                        font-family: "Segoe UI Symbol";
                        font-size: 22px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    next-tab-touch := TouchArea {
                        enabled: root.tabs.length > 1;
                        clicked => { root.tab-cycle(1); }
                    }
                }
                Rectangle {
                    width: 36px;
                    background: tab-list-touch.has-hover || root.tab-list-visible ? #30333a : transparent;
                    Text {
                        text: "⌄";
                        color: root.tabs.length > 0 ? #d7dae0 : #626872;
                        font-family: "Segoe UI Symbol";
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    tab-list-touch := TouchArea {
                        enabled: root.tabs.length > 0;
                        clicked => { root.tab-list-visible = !root.tab-list-visible; }
                    }
                }

                Rectangle {
                    width: 46px;
                    background: minimize-touch.has-hover ? #30333a : transparent;
                    Text { text: "—"; color: #d7dae0; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    minimize-touch := TouchArea { clicked => { root.minimized = true; } }
                }
                Rectangle {
                    width: 46px;
                    background: maximize-touch.has-hover ? #30333a : transparent;
                    Text {
                        text: root.maximized ? "❐" : "□";
                        color: #d7dae0;
                        font-family: "Segoe UI Symbol";
                        font-size: 19px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    maximize-touch := TouchArea { clicked => { root.maximized = !root.maximized; } }
                }
                Rectangle {
                    width: 46px;
                    background: close-touch.has-hover ? #c42b1c : transparent;
                    Text {
                        text: "×";
                        color: #d7dae0;
                        font-family: "Segoe UI Symbol";
                        font-size: 22px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    close-touch := TouchArea { clicked => { root.close(); } }
                }
            }
        }

        HorizontalLayout {
            spacing: 1px;
            Rectangle {
                horizontal-stretch: 0;
                width: root.sidebar-width;
                background: #20232a;
                VerticalLayout {
                    spacing: 0px;
                    Rectangle {
                        height: 30px;
                        background: #292d35;
                        Text {
                            text: "FILES";
                            color: #bbc0ca;
                            font-size: 11px;
                            vertical-alignment: center;
                            x: 10px;
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 0px;
                            for entry[index] in root.tree-entries: Rectangle {
                                height: 25px;
                                background: tree-touch.has-hover ? #343943 : transparent;
                                HorizontalLayout {
                                    padding-left: entry.depth * 14px + 8px;
                                    padding-right: 6px;
                                    spacing: 5px;
                                    Image {
                                        source: entry.icon;
                                        width: 22px;
                                        height: 22px;
                                        image-fit: contain;
                                    }
                                    Text {
                                        text: entry.name;
                                        color: entry.git-mark == "U" ? #65c466 : (entry.git-mark == "M" ? #e2b86b : #d5d8de);
                                        font-family: "Geist";
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: entry.git-mark;
                                        color: entry.git-mark == "U" ? #65c466 : #e2b86b;
                                        font-family: "Geist";
                                        font-size: 12px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                }
                                tree-touch := TouchArea { clicked => { root.tree-activated(index); } }
                            }
                        }
                    }

                }
            }

            workspace-area := Rectangle {
                background: #181a1f;
                horizontal-stretch: 1;
                max-width: 100000px;
                clip: true;
                private property <length> divider-size: 6px;
                private property <bool> vertical-split: root.workspace-layout == 0 || root.workspace-layout == 1;
                private property <bool> horizontal-split: root.workspace-layout == 2 || root.workspace-layout == 3;
                private property <length> editor-split-width: (self.width - self.divider-size) * root.panel-split-ratio;
                private property <length> terminal-split-width: self.width - self.divider-size - self.editor-split-width;
                private property <length> editor-split-height: (self.height - self.divider-size) * root.panel-split-ratio;
                private property <length> terminal-split-height: self.height - self.divider-size - self.editor-split-height;

                editor-panel := Rectangle {
                    x: root.workspace-layout == 2 ? workspace-area.terminal-split-width + workspace-area.divider-size : 0px;
                    y: root.workspace-layout == 1 ? workspace-area.terminal-split-height + workspace-area.divider-size : 0px;
                    width: workspace-area.horizontal-split ? workspace-area.editor-split-width : workspace-area.width;
                    height: workspace-area.vertical-split ? workspace-area.editor-split-height : workspace-area.height;
                    visible: root.workspace-layout != 5;
                    background: #181a1f;
                    clip: true;

                    VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 0px;
                        Rectangle {
                            height: 28px;
                            background: editor-drag-touch.pressed ? #343944
                                : (editor-drag-touch.has-hover ? #2b2f37 : #24272e);
                            Text {
                                text: "EDITOR  ·  DRAG TO DOCK";
                                color: #bbc0ca;
                                font-size: 11px;
                                x: 9px;
                                width: parent.width - 48px;
                                vertical-alignment: center;
                            }
                            editor-drag-touch := TouchArea {
                                private property <length> press-x: 0px;
                                private property <length> press-y: 0px;
                                width: parent.width - 38px;
                                mouse-cursor: move;
                                moved => {
                                    if (!self.pressed || (abs(self.mouse-x - self.press-x) < 5px
                                        && abs(self.mouse-y - self.press-y) < 5px)) {
                                        return;
                                    }
                                    root.update-dock-preview(
                                        0,
                                        self.absolute-position.x + self.mouse-x - workspace-area.absolute-position.x,
                                        self.absolute-position.y + self.mouse-y - workspace-area.absolute-position.y
                                    );
                                }
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down) {
                                        self.press-x = self.mouse-x;
                                        self.press-y = self.mouse-y;
                                    } else if (event.kind == PointerEventKind.up && root.dragging-panel == 0) {
                                        root.dock-panel(0, root.dock-preview);
                                    } else if (event.kind == PointerEventKind.cancel) {
                                        root.dragging-panel = -1;
                                        root.dock-preview = -1;
                                    }
                                }
                                double-clicked => {
                                    root.toggle-panel-maximize(0);
                                }
                            }
                            Rectangle {
                                x: parent.width - 36px;
                                width: 36px;
                                height: parent.height;
                                border-radius: 3px;
                                background: editor-maximize-touch.has-hover ? #3a3f48 : transparent;
                                Text {
                                    text: root.workspace-layout == 4 ? "❐" : "□";
                                    color: #d7dae0;
                                    font-family: "Segoe UI Symbol";
                                    font-size: 17px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                editor-maximize-touch := TouchArea {
                                    clicked => { root.toggle-panel-maximize(0); }
                                }
                            }
                        }
                    Rectangle {
                        horizontal-stretch: 1;
                        max-width: 100000px;
                        height: root.find-visible ? 36px : 0px;
                        background: #24272e;
                        clip: true;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            find-input := LineEdit {
                                placeholder-text: "Find in current file";
                                edited(text) => { root.find-requested(text); }
                                horizontal-stretch: 1;
                            }
                            Button { text: "Close"; clicked => { root.find-visible = false; } }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        max-width: 100000px;
                        vertical-stretch: 2;
                        background: #181a1f;
                        if root.active-tab < 0: Rectangle {
                            Image {
                                x: (parent.width - self.width) / 2;
                                y: max(36px, (parent.height - 150px) / 2);
                                width: 88px;
                                height: 88px;
                                source: @image-url("../assets/araseo-app-icon.png");
                                image-fit: contain;
                            }
                            Text {
                                x: 0px;
                                y: max(132px, (parent.height - 150px) / 2 + 101px);
                                width: parent.width;
                                text: "Araseo";
                                color: #d9dce2;
                                font-size: 18px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                x: 0px;
                                y: max(160px, (parent.height - 150px) / 2 + 132px);
                                width: parent.width;
                                text: "Open a file from the tree";
                                color: #737985;
                                horizontal-alignment: center;
                            }
                        }
                        if root.active-tab >= 0: HorizontalLayout {
                            width: parent.width;
                            height: parent.height;
                            spacing: 0px;
                            Rectangle {
                                width: 48px;
                                background: #1e1e1e;
                                clip: true;
                                Text {
                                    text: root.line-numbers;
                                    color: #858585;
                                    font-family: "Cascadia Mono";
                                    font-size: 14px;
                                    font-weight: 400;
                                    horizontal-alignment: right;
                                    vertical-alignment: top;
                                    x: 4px;
                                    width: parent.width - 10px;
                                    y: 6px + editor-scroll.viewport-y;
                                }
                            }
                            editor-pane := Rectangle {
                                private property <length> cursor-x: 0px;
                                private property <length> cursor-y: 0px;
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                background: #1e1e1e;
                                clip: true;

                                editor-scroll := ScrollView {
                                    x: 10px;
                                    y: 6px;
                                    width: parent.width - 10px;
                                    height: parent.height - 6px;
                                    viewport-width: max(self.visible-width, code-input.preferred-width + 2px);
                                    viewport-height: max(self.visible-height, code-input.preferred-height + 4px);

                                    if root.syntax-highlight-enabled: StyledText {
                                        width: editor-scroll.viewport-width;
                                        height: editor-scroll.viewport-height;
                                        text: root.highlighted-text;
                                        default-color: #d4d4d4;
                                        default-font-family: "Cascadia Mono";
                                        default-font-size: 14px;
                                        vertical-alignment: top;
                                    }

                                    code-input := TextInput {
                                        private property <int> requested-cursor-generation: root.editor-cursor-generation;
                                        width: editor-scroll.viewport-width;
                                        height: editor-scroll.viewport-height;
                                        text <=> root.editor-text;
                                        single-line: false;
                                        wrap: no-wrap;
                                        font-family: "Cascadia Mono";
                                        font-size: 14px;
                                        font-weight: 400;
                                        color: root.syntax-highlight-enabled && self.preedit-text == "" ? transparent : #d4d4d4;
                                        // Render selection colors in TextInput itself. Keeping the
                                        // foreground transparent can make the entire selection pass
                                        // disappear with some Windows GPU renderers.
                                        selection-background-color: #264f78;
                                        selection-foreground-color: #ffffff;
                                        page-height: editor-scroll.visible-height;
                                        text-cursor-width: 0px;
                                        changed requested-cursor-generation => {
                                            self.set-selection-offsets(root.editor-cursor-offset, root.editor-cursor-offset);
                                        }
                                        edited => {
                                            root.editor-edited(self.text, root.active-tab);
                                        }
                                        key-pressed(event) => {
                                            if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                                                self.copy();
                                                return accept;
                                            }
                                            if (event.modifiers.control && (event.text == "x" || event.text == "X")) {
                                                self.cut();
                                                return accept;
                                            }
                                            if (event.modifiers.control && (event.text == "a" || event.text == "A")) {
                                                self.select-all();
                                                return accept;
                                            }
                                            if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                                                if (event.modifiers.shift) {
                                                    root.redo-requested(root.active-tab);
                                                } else {
                                                    root.undo-requested(root.active-tab);
                                                }
                                                return accept;
                                            }
                                            if (event.modifiers.control && (event.text == "y" || event.text == "Y")) {
                                                root.redo-requested(root.active-tab);
                                                return accept;
                                            }
                                            if (event.modifiers.control && event.text == "s") {
                                                root.save-requested();
                                                return accept;
                                            }
                                            if (event.modifiers.control && event.text == "f") {
                                                root.find-visible = true;
                                                return accept;
                                            }
                                            return reject;
                                        }
                                        cursor-position-changed(position) => {
                                            root.editor-selection-anchor = self.anchor-position-byte-offset;
                                            root.editor-selection-cursor = self.cursor-position-byte-offset;
                                            root.copy-feedback-active = false;
                                            copy-feedback-timer.stop();
                                            root.editor-selection-changed(
                                                self.anchor-position-byte-offset,
                                                self.cursor-position-byte-offset
                                            );
                                            editor-pane.cursor-x = position.x;
                                            editor-pane.cursor-y = position.y;
                                            if (position.x + editor-scroll.viewport-x < 0px) {
                                                editor-scroll.viewport-x = max(editor-scroll.visible-width - self.width, -position.x);
                                            } else if (position.x + editor-scroll.viewport-x > editor-scroll.visible-width - 2px) {
                                                editor-scroll.viewport-x = min(0px, max(editor-scroll.visible-width - self.width, editor-scroll.visible-width - position.x - 2px));
                                            }
                                            if (position.y + editor-scroll.viewport-y < 0px) {
                                                editor-scroll.viewport-y = max(editor-scroll.visible-height - self.height, -position.y);
                                            } else if (position.y + editor-scroll.viewport-y > editor-scroll.visible-height - 20px) {
                                                editor-scroll.viewport-y = min(0px, max(editor-scroll.visible-height - self.height, editor-scroll.visible-height - position.y - 20px));
                                            }
                                        }
                                    }

                                    Rectangle {
                                        x: editor-pane.cursor-x;
                                        y: editor-pane.cursor-y;
                                        width: 2px;
                                        height: 18px;
                                        background: #f0f0f0;
                                        visible: code-input.has-focus
                                            && code-input.preedit-text == ""
                                            && code-input.cursor-position-byte-offset == code-input.anchor-position-byte-offset;
                                    }
                                }

                                if root.editor-selection-length > 0: Rectangle {
                                    x: parent.width - 92px;
                                    y: 8px;
                                    width: 78px;
                                    height: 28px;
                                    border-radius: 4px;
                                    background: root.copy-feedback-active ? #2e7d4f
                                        : (copy-selection-touch.has-hover ? #3a3d43 : #292c32);
                                    border-width: 1px;
                                    border-color: root.copy-feedback-active ? #55b979 : #555960;
                                    Text {
                                        text: root.copy-feedback-active ? "Copied!" : "Copy";
                                        color: #f0f0f0;
                                        font-family: "Geist";
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    copy-selection-touch := TouchArea {
                                        clicked => {
                                            code-input.copy();
                                            root.show-copy-feedback();
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                }

                terminal-panel := Rectangle {
                        x: root.workspace-layout == 3 ? workspace-area.editor-split-width + workspace-area.divider-size : 0px;
                        y: root.workspace-layout == 0 ? workspace-area.editor-split-height + workspace-area.divider-size : 0px;
                        width: workspace-area.horizontal-split ? workspace-area.terminal-split-width : workspace-area.width;
                        height: workspace-area.vertical-split ? workspace-area.terminal-split-height : workspace-area.height;
                        visible: root.workspace-layout != 4;
                        background: #111318;
                        clip: true;
                        VerticalLayout {
                            width: parent.width;
                            height: parent.height;
                            spacing: 0px;
                            Rectangle {
                                horizontal-stretch: 1;
                                max-width: 100000px;
                                height: 28px;
                                background: terminal-drag-touch.pressed ? #343944
                                    : (terminal-drag-touch.has-hover ? #2b2f37 : #24272e);
                                Text {
                                    text: "TERMINAL — WSL  ·  DRAG TO DOCK";
                                    color: #bbc0ca;
                                    font-size: 11px;
                                    x: 9px;
                                    width: parent.width - 48px;
                                    vertical-alignment: center;
                                }
                                terminal-drag-touch := TouchArea {
                                    private property <length> press-x: 0px;
                                    private property <length> press-y: 0px;
                                    width: parent.width - 38px;
                                    mouse-cursor: move;
                                    moved => {
                                        if (!self.pressed || (abs(self.mouse-x - self.press-x) < 5px
                                            && abs(self.mouse-y - self.press-y) < 5px)) {
                                            return;
                                        }
                                        root.update-dock-preview(
                                            1,
                                            self.absolute-position.x + self.mouse-x - workspace-area.absolute-position.x,
                                            self.absolute-position.y + self.mouse-y - workspace-area.absolute-position.y
                                        );
                                }
                                pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down) {
                                            self.press-x = self.mouse-x;
                                            self.press-y = self.mouse-y;
                                        } else if (event.kind == PointerEventKind.up && root.dragging-panel == 1) {
                                            root.dock-panel(1, root.dock-preview);
                                        } else if (event.kind == PointerEventKind.cancel) {
                                            root.dragging-panel = -1;
                                            root.dock-preview = -1;
                                        }
                                    }
                                    double-clicked => {
                                        root.toggle-panel-maximize(1);
                                    }
                                }
                                Rectangle {
                                    x: parent.width - 36px;
                                    width: 36px;
                                    height: parent.height;
                                    border-radius: 3px;
                                    background: terminal-maximize-touch.has-hover ? #3a3f48 : transparent;
                                    Text {
                                        text: root.workspace-layout == 5 ? "❐" : "□";
                                        color: #d7dae0;
                                        font-family: "Segoe UI Symbol";
                                        font-size: 17px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    terminal-maximize-touch := TouchArea {
                                        clicked => { root.toggle-panel-maximize(1); }
                                    }
                                }
                            }
                            terminal-focus := FocusScope {
                                horizontal-stretch: 1;
                                max-width: 100000px;
                                vertical-stretch: 1;
                                focus-on-click: true;
                                terminal-scroll := ScrollView {
                                    viewport-width: max(self.visible-width, root.terminal-grid-columns * 8px);
                                    viewport-height: max(self.visible-height, root.terminal-grid-rows * 18px);
                                    viewport-x: 0px;
                                    viewport-y: 0px;
                                    private property <int> follow-generation: root.terminal-update-generation;
                                    private property <length> cursor-top: max(0, root.terminal-cursor-row) * 18px;
                                    private property <length> cursor-bottom: self.cursor-top + 18px;
                                    changed follow-generation => {
                                        if (root.terminal-cursor-row >= 0) {
                                            if (self.cursor-top + self.viewport-y < 0px) {
                                                self.viewport-y = -self.cursor-top;
                                            } else if (self.cursor-bottom + self.viewport-y > self.visible-height) {
                                                self.viewport-y = self.visible-height - self.cursor-bottom;
                                            }
                                            self.viewport-y = max(
                                                self.visible-height - self.viewport-height,
                                                min(0px, self.viewport-y)
                                            );
                                        }
                                    }
                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        width: root.terminal-grid-columns * 8px;
                                        height: root.terminal-grid-rows * 18px;
                                        for cell[index] in root.terminal-cells: Rectangle {
                                            x: Math.mod(index, max(1, root.terminal-grid-columns)) * 8px;
                                            y: floor(index / max(1, root.terminal-grid-columns)) * 18px;
                                            width: cell.column-span * 8px;
                                            height: 18px;
                                            visible: cell.column-span > 0;
                                            background: cell.cursor ? cell.foreground : cell.background;
                                            Text {
                                                text: cell.glyph;
                                                color: cell.cursor ? cell.background : cell.foreground;
                                                font-family: "Cascadia Mono";
                                                font-size: 14px;
                                                font-weight: cell.bold ? 700 : 500;
                                                width: parent.width;
                                                height: parent.height;
                                                vertical-alignment: center;
                                                wrap: no-wrap;
                                            }
                                        }
                                    }
                                }
                                terminal-ime-input := TextInput {
                                    x: max(0px, root.terminal-cursor-column * 8px + terminal-scroll.viewport-x);
                                    y: max(0px, root.terminal-cursor-row * 18px + terminal-scroll.viewport-y);
                                    width: max(18px, terminal-focus.width - self.x);
                                    height: 18px;
                                    text: "";
                                    single-line: true;
                                    wrap: no-wrap;
                                    font-family: "Cascadia Mono";
                                    font-size: 14px;
                                    font-weight: 500;
                                    color: #d8dee9;
                                    selection-background-color: #264f78;
                                    selection-foreground-color: #ffffff;
                                    text-cursor-width: 0px;
                                    edited => {
                                        if (self.text != "") {
                                            root.terminal-text(self.text);
                                            self.text = "";
                                            self.set-selection-offsets(0, 0);
                                        }
                                    }
                                    key-pressed(event) => {
                                        if (event.text == Key.Shift || event.text == Key.ShiftR
                                            || event.text == Key.Control || event.text == Key.ControlR
                                            || event.text == Key.Alt || event.text == Key.AltGr
                                            || event.text == Key.Meta || event.text == Key.MetaR
                                            || event.text == Key.CapsLock) {
                                            return accept;
                                        }
                                        if (event.text == Key.UpArrow) {
                                            root.terminal-key("<UP>", event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
                                            return accept;
                                        }
                                        if (event.text == Key.DownArrow) {
                                            root.terminal-key("<DOWN>", event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
                                            return accept;
                                        }
                                        if (event.text == Key.LeftArrow) {
                                            root.terminal-key("<LEFT>", event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
                                            return accept;
                                        }
                                        if (event.text == Key.RightArrow) {
                                            root.terminal-key("<RIGHT>", event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
                                            return accept;
                                        }
                                        if (event.text == Key.Home) { root.terminal-key("<HOME>", false, false, false); return accept; }
                                        if (event.text == Key.End) { root.terminal-key("<END>", false, false, false); return accept; }
                                        if (event.text == Key.PageUp) { root.terminal-key("<PAGEUP>", false, false, false); return accept; }
                                        if (event.text == Key.PageDown) { root.terminal-key("<PAGEDOWN>", false, false, false); return accept; }
                                        if (event.text == Key.Delete) { root.terminal-key("<DELETE>", false, false, false); return accept; }
                                        if (event.text == Key.Backspace) { root.terminal-key("<BACKSPACE>", false, false, false); return accept; }
                                        if (event.text == Key.Return) { root.terminal-key("<ENTER>", false, false, false); return accept; }
                                        if (event.text == Key.Backtab) { root.terminal-key("<BACKTAB>", false, false, false); return accept; }
                                        if (event.text == Key.Tab) { root.terminal-key("<TAB>", false, false, false); return accept; }
                                        if (event.text == Key.Escape) { root.terminal-key("<ESCAPE>", false, false, false); return accept; }
                                        if (event.modifiers.control || event.modifiers.alt) {
                                            root.terminal-key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
                                            return accept;
                                        }
                                        return reject;
                                    }
                                }
                                terminal-click := TouchArea {
                                    clicked => { root.focus-terminal(); }
                                }
                            }
                        }
                    }

                    panel-divider := Rectangle {
                        visible: workspace-area.vertical-split || workspace-area.horizontal-split;
                        x: workspace-area.horizontal-split
                            ? (root.workspace-layout == 2
                                ? workspace-area.terminal-split-width
                                : workspace-area.editor-split-width)
                            : 0px;
                        y: workspace-area.vertical-split
                            ? (root.workspace-layout == 1
                                ? workspace-area.terminal-split-height
                                : workspace-area.editor-split-height)
                            : 0px;
                        width: workspace-area.horizontal-split
                            ? workspace-area.divider-size
                            : workspace-area.width;
                        height: workspace-area.vertical-split
                            ? workspace-area.divider-size
                            : workspace-area.height;
                        background: divider-touch.pressed || divider-touch.has-hover ? #5686b3 : #313640;

                        divider-touch := TouchArea {
                            mouse-cursor: workspace-area.horizontal-split ? ew-resize : ns-resize;
                            moved => {
                                if (!self.pressed) {
                                    return;
                                }
                                if (workspace-area.horizontal-split) {
                                    let pointer-x = self.absolute-position.x + self.mouse-x
                                        - workspace-area.absolute-position.x;
                                    root.panel-split-ratio = max(0.2, min(0.8,
                                        root.workspace-layout == 2
                                            ? (workspace-area.width - workspace-area.divider-size - pointer-x)
                                                / (workspace-area.width - workspace-area.divider-size)
                                            : pointer-x / (workspace-area.width - workspace-area.divider-size)
                                    ));
                                } else {
                                    let pointer-y = self.absolute-position.y + self.mouse-y
                                        - workspace-area.absolute-position.y;
                                    root.panel-split-ratio = max(0.2, min(0.8,
                                        root.workspace-layout == 1
                                            ? (workspace-area.height - workspace-area.divider-size - pointer-y)
                                                / (workspace-area.height - workspace-area.divider-size)
                                            : pointer-y / (workspace-area.height - workspace-area.divider-size)
                                    ));
                                }
                            }
                        }
                    }

                    if root.dragging-panel >= 0 && root.dock-preview >= 0: Rectangle {
                        x: root.dock-preview == 1 ? workspace-area.width / 2
                            : (root.dock-preview == 4 ? workspace-area.width / 4 : 0px);
                        y: root.dock-preview == 3 ? workspace-area.height / 2
                            : (root.dock-preview == 4 ? workspace-area.height / 4 : 0px);
                        width: root.dock-preview == 0 || root.dock-preview == 1
                            ? workspace-area.width / 2
                            : (root.dock-preview == 4 ? workspace-area.width / 2 : workspace-area.width);
                        height: root.dock-preview == 2 || root.dock-preview == 3
                            ? workspace-area.height / 2
                            : (root.dock-preview == 4 ? workspace-area.height / 2 : workspace-area.height);
                        background: #315f8a99;
                        border-width: 2px;
                        border-color: #79b8f3;
                        border-radius: 5px;

                        Text {
                            text: root.dock-preview == 0 ? "Dock left"
                                : (root.dock-preview == 1 ? "Dock right"
                                : (root.dock-preview == 2 ? "Dock top"
                                : (root.dock-preview == 3 ? "Dock bottom" : "Maximize")));
                            color: white;
                            font-family: "Geist";
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

        Rectangle {
            height: 24px;
            background: #2f6f9f;
            HorizontalLayout {
                padding-left: 9px;
                padding-right: 9px;
                spacing: 6px;
                Text { text: root.workspace-name; color: white; vertical-alignment: center; }
                Text { text: root.active-path; color: white; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                if root.editor-selection-length > 0: Text {
                    text: root.editor-selection-length + " bytes selected";
                    color: white;
                    vertical-alignment: center;
                }
                Text { text: root.status-text; color: white; vertical-alignment: center; }
                if root.save-conflict: Button { text: "Reload"; clicked => { root.reload-requested(); } }
                if root.save-conflict: Button { text: "Overwrite"; clicked => { root.force-save-requested(); } }
            }
        }
    }

        if root.tab-list-visible: TouchArea {
            x: 0px;
            y: 34px;
            width: root.width;
            height: root.height - 34px;
            clicked => { root.tab-list-visible = false; }
        }

        if root.tab-list-visible: Rectangle {
            x: max(root.sidebar-width, root.width - 498px);
            y: 34px;
            width: min(360px, root.width - root.sidebar-width);
            height: min(420px, max(72px, root.tabs.length * 30px + 42px));
            background: #252930;
            border-width: 1px;
            border-color: #454b56;
            clip: true;

            VerticalLayout {
            spacing: 0px;
            Rectangle {
                height: 40px;
                background: #20232a;
                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: "OPEN EDITORS  " + root.tabs.length;
                    color: #bbc0ca;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 0px;
                    for tab[index] in root.tabs: Rectangle {
                        height: 30px;
                        background: index == root.active-tab ? #373d47
                            : (open-tab-touch.has-hover ? #303640 : transparent);
                        Text {
                            x: 12px;
                            width: parent.width - 44px;
                            text: tab.title;
                            color: index == root.active-tab ? #ffffff : #d5d8de;
                            font-family: "Geist";
                            font-size: 12px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if tab.dirty: Text {
                            x: parent.width - 30px;
                            width: 18px;
                            text: "●";
                            color: #e2b86b;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        open-tab-touch := TouchArea {
                            clicked => {
                                root.tab-list-visible = false;
                                root.tab-activated(index);
                            }
                        }
                    }
                }
            }
            }
        }
    }
}

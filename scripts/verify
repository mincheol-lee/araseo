#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mode=${1:-core}
fontconfig_link_dir=/tmp/araseo-fontconfig

case "$mode" in
    core)
        ;;
    --windows|all|--all)
        ;;
    *)
        echo "Usage: $0 [core|--windows|--all]" >&2
        exit 2
        ;;
esac

echo "[1/3] Running headless core and integration tests"
cargo test --locked --manifest-path "$repository_root/harness/Cargo.toml"

echo "[2/3] Running real Slint mouse-selection and clipboard tests"
mkdir -p "$fontconfig_link_dir"
ln -sf /usr/lib/x86_64-linux-gnu/libfontconfig.so.1 "$fontconfig_link_dir/libfontconfig.so"
PKG_CONFIG="$repository_root/ui-harness/tools/pkg-config" \
    cargo test --locked --manifest-path "$repository_root/ui-harness/Cargo.toml"

if [ "$mode" = "core" ]; then
    echo "Araseo core verification passed."
    exit 0
fi

echo "[3/3] Compiling all tests and the UI for Windows"
cargo test \
    --locked \
    --manifest-path "$repository_root/Cargo.toml" \
    --target x86_64-pc-windows-gnu \
    --no-run
cargo check \
    --locked \
    --manifest-path "$repository_root/Cargo.toml" \
    --target x86_64-pc-windows-gnu

echo "Araseo core and Windows UI verification passed."

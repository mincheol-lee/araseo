#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mode=${1:-core}
export CARGO_INCREMENTAL=0
export CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-2}

case "$mode" in
    core)
        ;;
    --windows|all|--all)
        ;;
    *)
        echo "Usage: $0 [core|--windows|--all]" >&2
        exit 2
        ;;
esac

echo "[1/4] Running headless core and integration tests"
cargo test --locked --manifest-path "$repository_root/harness/Cargo.toml"

echo "[2/4] Running production GPUI editor, IME and docking tests"
cargo test --locked --manifest-path "$repository_root/ui-harness/Cargo.toml"

echo "[3/4] Testing the release installer and WSL launcher"
"$repository_root/scripts/test-release-install"

if [ "$mode" = "core" ]; then
    echo "Araseo core verification passed."
    exit 0
fi

echo "[4/4] Compiling all tests and the UI for Windows"
cargo test \
    --locked \
    --manifest-path "$repository_root/Cargo.toml" \
    --target x86_64-pc-windows-gnu \
    --no-run
cargo test \
    --locked \
    --manifest-path "$repository_root/harness/Cargo.toml" \
    --target x86_64-pc-windows-gnu \
    --no-run
cargo check \
    --locked \
    --manifest-path "$repository_root/Cargo.toml" \
    --target x86_64-pc-windows-gnu

echo "Araseo core and Windows UI verification passed."
